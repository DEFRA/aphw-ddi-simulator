{
  "name": "aphw-ddi-simulator",
  "version": "0.1.6",
  "description": "One Login Simulator for aphw-ddi-simulator",
  "homepage": "https://github.com/DEFRA/aphw-ddi-simulator",
  "main": "app/index.js",
  "scripts": {
    "build": "npx tsc",
    "pretest": "eslint . --ext .ts,.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --testPathPatterns=test/unit --coverage=false",
    "test:watch": "jest --coverage=false --onlyChanged --watch --runInBand",
    "test:lint": "standard",
    "test:debug": "node --inspect-brk=0.0.0.0 ./node_modules/jest/bin/jest.js --coverage=false --onlyChanged --watch --runInBand --no-cache",
    "start:watch": "nodemon --inspect=0.0.0.0 --ext js --legacy-watch app/index.js",
    "start:debug": "nodemon --inspect-brk=0.0.0.0 --ext js --legacy-watch app/index.js"
  },
  "author": "Defra",
  "contributors": [],
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@hapi/hapi": "^21.4.10",
    "applicationinsights": "^3.16.0",
    "convict": "^6.2.4",
    "convict-format-with-validator": "^6.2.0",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "hapi-pino": "^12.1.0",
    "joi": "^17.13.8",
    "jose": "^5.9.6",
    "log-timestamp": "^0.3.0",
    "pino": "^9.5.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.8.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.0.1",
    "standard": "^17.1.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "standard": {
    "globals": [
      "describe",
      "beforeEach",
      "expect",
      "test",
      "afterEach",
      "jest",
      "beforeAll",
      "afterAll"
    ]
  },
  "nodemonConfig": {
    "ignore": [
      "**/test-output/**"
    ]
  },
  "overrides": {
    "uuid": "$uuid",
    "glob@^10": "^14.0.3",
    "glob@^13": "^14.0.3",
    "minimatch@^10": "^11.0.4"
  }
}
